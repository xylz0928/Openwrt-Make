#!/bin/sh
# zed-opota —— 官方 x86 固件 OTA 核心（双源版）
#
# 用法: zed-opota <check|space <bytes>|download <bytes>|progress|install|clean <target>>
#
# 固件源（前台用户单选，默认 Zed-Github，后台不自动切换）：
#   Zed-Github：GitHub Release，tag=OP_x86_Official_Ryyyy-mm-dd
#   Zed-NAS：NAS 静态站（static.z.7ze.top:20443，= ZZ-Synology volume7 的 web 根）
#     版本: /files/build_date_openwrt.txt  (YYYY-MM-DD)
#     固件: /files/OpenWrt-x64.img.gz
#     校验: /files/sha256sums （缺失则中止下载，绝不落无校验固件）
#
# 设计约束（对应需求 1.2 / 2.2 / 2.3）：
#  - 不做任何更新缓存：check 每次实时探测两个源
#  - 下载前强制 tmpfs 空间检查：固件体积 + 当前配置备份体积 + 4MB 余量
#  - 刷机前强制 sha256 校验，失败删除产物并明确报"下载成功但固件校验失败"
#  - 清理目标白名单（smart/udpxy），"原地清零"截断（进程持句柄时 rm 不释放空间）
#
# stdout 只输出 JSON；进度/状态落盘 /tmp/zzota/（瞬态下载状态，非更新缓存）

set -u

# OPOTA_* 仅用于本地单元测试/调试覆盖，设备端（uhttpd popen）环境固定为默认值
WORK=${OPOTA_WORK:-/tmp/zzota}
RELEASE_FILE=${OPOTA_RELEASE_FILE:-/etc/openwrt_release}
SMART_FILE=${OPOTA_SMART_FILE:-/etc/openclash/smart_weight_data.csv}
UDPXY_FILE=${OPOTA_UDPXY_FILE:-/tmp/log/udpxy}
# 操作日志：放 /etc/zed-opota/ 是为了"固件刷新后仍在"——
# 包内 /lib/upgrade/keep.d/zed-opota 声明了该文件，sysupgrade 保留配置刷机时
# 会把它打进备份集并在新固件首启时还原；写入时自动截断到最多100行
LOG_FILE=${OPOTA_LOG:-/etc/zed-opota/ota.log}
LOG_MAX=100
REPO="xylz0928/Openwrt-Make"
MARGIN=$((4 * 1024 * 1024))	# 4MB 余量

# ---------------- 型号 profile（多型号 OTA） ----------------
OPOTA_BOARD_JSON=${OPOTA_BOARD_JSON:-/etc/board.json}
OPOTA_EFI_DIR=${OPOTA_EFI_DIR:-/sys/firmware/efi}

# 识别产品线：x86-efi | 360t7-108m | unsupported
detect_profile() {
	local tgt board
	tgt=$(sed -n 's/^DISTRIB_TARGET=//p' "$RELEASE_FILE" 2>/dev/null | head -n1)
	tgt=${tgt#\"}
	tgt=${tgt#\'}
	tgt=${tgt%%\"*}
	tgt=${tgt%%\'*}
	case "$tgt" in
	x86/*)
		echo "x86-efi"; return 0 ;;
	mediatek/*)
		if [ -f "$OPOTA_BOARD_JSON" ]; then
			board=$(jsonfilter -e '@.model.id' < "$OPOTA_BOARD_JSON" 2>/dev/null)
			case "$board" in
			*360t7*|*qihoo*) echo "360t7-108m"; return 0 ;;
			esac
		fi
		;;
	esac
	echo "unsupported"
}

# x86 固件家族识别（读 DISTRIB_RELEASE 原串，2026-10-04 用户规则）：
#   LEDE 开头 → lede（如 SNF 的 "LEDE R2026-08-15 by Zed-7nian"）
#   其余（如官方线 "R2026-10-03.by.Zed-7nian"）→ official
# 非 x86 不使用（硬路由按 profile 走）
fw_family() {
	# 2026-10-05 实机校准（SNF）：LEDE 标记可能在
	#   openwrt_release 的 DISTRIB_DESCRIPTION='LEDE ' / DISTRIB_RELEASE
	#   os-release  的 OPENWRT_RELEASE="LEDE …" / PRETTY_NAME / VERSION
	# 任一命中即 lede（LEDE 开头或含 LEDE 均算），否则 official
	local v
	v=$(grep -E '^DISTRIB_(DESCRIPTION|RELEASE)=' "$RELEASE_FILE" 2>/dev/null)
	case "$v" in
	*LEDE*) echo "lede"; return 0 ;;
	esac
	v=$(grep -E '^(OPENWRT_RELEASE|PRETTY_NAME|VERSION)=' "$(dirname "$RELEASE_FILE")/os-release" 2>/dev/null)
	case "$v" in
	*LEDE*) echo "lede"; return 0 ;;
	esac
	echo "official"
}

# 当前设备型号（纯本地读取，供前端加载即显示、不等检查更新）：
# board.json 的 model.name → DISTRIB_TARGET 兜底
model_name() {
	local n
	# x86 系：按【实际运行架构 + 实际启动方式】构造（2026-10-04 用户规则）：
	#   uname -m → x64/x86；/sys/firmware/efi 存在 = UEFI 启动才带 -EFI
	#   → x86_x64-EFI / x86_x64 / x86_x86-EFI / x86_x86
	case "$(uname -m 2>/dev/null)" in
	x86_64)
		n="x86_x64"
		[ -d "$OPOTA_EFI_DIR" ] && n="${n}-EFI"
		printf '%s' "$n"
		return 0
		;;
	i386|i486|i586|i686)
		n="x86_x86"
		[ -d "$OPOTA_EFI_DIR" ] && n="${n}-EFI"
		printf '%s' "$n"
		return 0
		;;
	esac
	# 非 x86（硬路由）→ OpenWrt 宣告型号（board.json model.name → DISTRIB_TARGET 兜底）
	if [ -f "$OPOTA_BOARD_JSON" ]; then
		n=$(jsonfilter -e '@.model.name' < "$OPOTA_BOARD_JSON" 2>/dev/null)
		if [ -n "$n" ]; then
			printf '%s' "$n"
			return 0
		fi
	fi
	n=$(sed -n 's/^DISTRIB_TARGET=//p' "$RELEASE_FILE" 2>/dev/null | head -n1)
	n=${n#\"}
	n=${n#\'}
	n=${n%%\"*}
	n=${n%%\'*}
	printf '%s' "${n:-unknown}"
}

# 108M 固件方案校验（360T7 专用，2026-10-04 用户指令）：
# ① board id 必须带 108M（qihoo,360t7,108M）
# ② /proc/mtd 的 ubi 分区必须正好 108MiB = 06c00000（实测两台108M机一致）
# 任一不符 → 拒绝提供固件，防把108M镜像刷到非108M方案机器上变砖
MTD_FILE=${OPOTA_MTD_FILE:-/proc/mtd}
flash_108m_ok() {
	local id hex
	if [ -f "$OPOTA_BOARD_JSON" ]; then
		id=$(jsonfilter -e '@.model.id' < "$OPOTA_BOARD_JSON" 2>/dev/null)
		case "$id" in *108M*) ;; *) return 1 ;; esac
	fi
	hex=$(awk '$4 == "\"ubi\"" { print $2 }' "$MTD_FILE" 2>/dev/null | head -n1)
	[ "$hex" = "06c00000" ] || return 1
	return 0
}

# profile 配置项：tag_prefix / asset / static_img / static_ver / default_src
profile_conf() {
	case "$PROFILE" in
	x86-efi)
		case "$1" in
		tag_prefix)  echo "OP_x86_Official_" ;;
		asset)       echo "openwrt-x86-64-generic-squashfs-combined-efi.img.gz" ;;
		static_img)  echo "https://static.z.7ze.top:20443/files/OpenWrt-x64.img.gz" ;;
		static_ver)  echo "https://static.z.7ze.top:20443/files/build_date_openwrt.txt" ;;
		default_src) echo "github" ;;
		esac ;;
	360t7-108m)
		case "$1" in
		tag_prefix)  echo "OP_MT7981_" ;;
		asset)       echo "immortalwrt-mediatek-filogic-qihoo_360t7_108M-squashfs-sysupgrade.bin" ;;
		static_img)  echo "https://static.z.7ze.top:20443/files/360-t7-108M.bin" ;;
		static_ver)  echo "https://static.z.7ze.top:20443/files/build_date_mt798x.txt" ;;
		# 默认源全型号统一 GitHub（与 x86 设计一致，2026-10-04 用户指令）；
		# mt7981 日期化 tag 首次产出前，GitHub 探测会失败并提示切 Zed-NAS
		default_src) echo "github" ;;
		esac ;;
	*) return 1 ;;
	esac
}

PROFILE=$(detect_profile)
FAMILY=$(fw_family)
if [ "$PROFILE" = "unsupported" ]; then
	IMG=""; TAG_PREFIX=""
	STATIC_VER_URL=""; STATIC_IMG_URL=""; STATIC_SHA_URL=""; STATIC_ASSET=""
	DEFAULT_SRC="github"
else
	TAG_PREFIX=$(profile_conf tag_prefix)
	IMG=$(profile_conf asset)
	STATIC_VER_URL=$(profile_conf static_ver)
	STATIC_IMG_URL=$(profile_conf static_img)
	# 统一命名（与 NAS write_product_sha 对齐）：<固件名>.sha256sums
	STATIC_SHA_URL="${STATIC_IMG_URL}.sha256sums"
	STATIC_ASSET=$(basename "$STATIC_IMG_URL")
	DEFAULT_SRC=$(profile_conf default_src)
fi

mkdir -p "$WORK"

# 带重试的抓取（3 次、间隔 1s）：实机出现过瞬时 DNS 解析失败（rc6），
# 单次失败会把可达源误判成"不可达"——所有外抓统一走这里
curl_retry() {
	local n=1
	while :; do
		curl "$@" && return 0
		n=$((n + 1))
		[ "$n" -gt 3 ] && return 1
		sleep 1
	done
}

# ---------- JSON 输出辅助 ----------
jesc() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

# 拼接所有参数后输出一行（JSON 片段间的空格合法）
emit() {
	printf '%s\n' "$*"
}

# 追加一行操作日志并截断到最多 LOG_MAX 行；日志失败绝不影响业务动作
log_line() {
	local n tmp
	mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null
	printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE" 2>/dev/null || return 0
	n=$(wc -l < "$LOG_FILE" 2>/dev/null | tr -dc '0-9')
	if [ "${n:-0}" -gt "$LOG_MAX" ]; then
		tmp="$LOG_FILE.tmp"
		tail -n "$LOG_MAX" "$LOG_FILE" > "$tmp" 2>/dev/null && mv "$tmp" "$LOG_FILE" 2>/dev/null
	fi
	return 0
}

# fail "消息" ["额外的JSON键值对"]
fail() {
	local msg extra
	msg=$(jesc "$1")
	extra=""
	[ $# -gt 1 ] && extra=",$2"
	emit "{\"ok\":false,\"error\":\"${msg}\"${extra}}"
	exit 0
}

# ---------- 通用数据源 ----------
local_ver() {
	grep -o 'R[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}' "$RELEASE_FILE" 2>/dev/null | head -n1
}

# 固定版本文件（2026-10-04 用户指令：前端与后端【都直接读它】取本固件最后一次
# 成功编译日期，不再经过任何 api.github.com）：由各 workflow 编译成功后写回
LB_URL="https://raw.githubusercontent.com/${REPO}/main/last_build.txt"

# 产品线 → 版本文件行键
profile_key() {
	case "$PROFILE" in
	x86-efi) echo "x86_Official" ;;
	360t7-108m) echo "MT7981" ;;
	*) return 1 ;;
	esac
}

# 读版本文件并解析本型号行（KEY=日期 [资产体积 构建时间]；跳过注释，兼容 =/: 分隔）
# 成功设置 GH_TAG/GH_DATE/GH_IMG_URL/GH_SHA_URL/GH_SIZE/GH_PUB，返回 0
lb_probe() {
	local key out date size pub
	key=$(profile_key) || return 1
	out=$(curl_retry -fsSL --max-time 8 "$LB_URL" 2>/dev/null | awk -v k="$key" '
		{
			t = $0
			sub(/^[ \t]+/, "", t)
			if (substr(t, 1, 1) == "#") next
			i = index(t, "=")
			j = index(t, ":")
			p = (i > 0 && (j == 0 || i < j)) ? i : j
			if (p == 0) next
			key = substr(t, 1, p - 1)
			gsub(/[ \t]/, "", key)
			if (key != k) next
			rest = substr(t, p + 1)
			sub(/^[ \t]+/, "", rest)
			n = split(rest, a, /[ \t]+/)
			if (n >= 1 && a[1] ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) {
				print a[1]
				if (n >= 2) print a[2]
				if (n >= 3) print a[3]
				exit
			}
		}')
	[ -n "$out" ] || return 1
	date=$(printf '%s' "$out" | sed -n 1p)
	[ -n "$date" ] || return 1
	size=$(printf '%s' "$out" | sed -n 2p)
	pub=$(printf '%s' "$out" | sed -n 3p)
	GH_TAG="${TAG_PREFIX}R${date}"
	GH_DATE="R${date}"
	GH_IMG_URL="https://github.com/${REPO}/releases/download/${GH_TAG}/${IMG}"
	GH_SHA_URL="https://github.com/${REPO}/releases/download/${GH_TAG}/sha256sums"
	case "$size" in ''|*[!0-9]*) GH_SIZE=0 ;; *) GH_SIZE=$size ;; esac
	GH_PUB=${pub:-}
	return 0
}


# HEAD 获取远端固件字节数（stdout 数字），失败输出 0
remote_size() {
	local cl
	cl=$(curl_retry -sIL --max-time 15 "$1" 2>/dev/null | tr -d '\r' \
		| grep -i '^content-length:' | tail -n1 | tr -dc '0-9')
	printf '%s' "${cl:-0}"
}

tmp_free() {
	df -k /tmp | awk 'NR==2 {print $4 * 1024}' | tr -dc '0-9'
}

tmp_total() {
	df -k /tmp | awk 'NR==2 {print $2 * 1024}' | tr -dc '0-9'
}

# 当前配置备份体积（字节）：sysupgrade -b 实测，失败回退 du 估算
cfg_size() {
	local n
	if sysupgrade -b "$WORK/cfg.tgz" >/dev/null 2>&1 && [ -s "$WORK/cfg.tgz" ]; then
		n=$(wc -c < "$WORK/cfg.tgz" | tr -dc '0-9')
		rm -f "$WORK/cfg.tgz"
		printf '%s' "${n:-0}"
		return
	fi
	rm -f "$WORK/cfg.tgz"
	n=$(du -sk /etc/config 2>/dev/null | awk '{print $1 * 1024}' | tr -dc '0-9')
	printf '%s' "${n:-0}"
}

# 工作区内已缓存的固件字节数（含 .part 半成品）：下载前会 rm -rf 工作区，
# 即"原地替换"，净增空间为0 → 空间检查不得重复计入（需求2.3精化）
cached_bytes() {
	local n=0 f
	for f in "$WORK"/*.img.gz "$WORK"/*.bin "$WORK"/*.part; do
		[ -f "$f" ] || continue
		n=$((n + $(wc -c < "$f" | tr -dc '0-9')))
	done
	printf '%s' "$n"
}

stage_get() {
	cat "$WORK/stage" 2>/dev/null || printf 'idle'
}

err_get() {
	cat "$WORK/err" 2>/dev/null
}

asset_get() {
	cat "$WORK/asset" 2>/dev/null || printf '%s' "$IMG"
}

# ---------- 双源探测 ----------
# tag 白名单校验（浏览器查询 GitHub 后传入；必须 = 本产品前缀 + R日期）
valid_tag() {
	case "$1" in
	"${TAG_PREFIX}"R[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) return 0 ;;
	*) return 1 ;;
	esac
}

# 由显式 tag（CLI/前端透传）直接构造 GitHub 下载地址；无 tag 时走 lb_probe 读固定文件。
# 两路都不碰 api.github.com：github.com 直链无配额，路由器出口零 API 消耗
gh_from_tag() {
	valid_tag "$1" || return 1
	GH_TAG=$1
	GH_DATE=$(printf '%s' "$GH_TAG" | grep -o 'R[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}')
	[ -n "$GH_DATE" ] || return 1
	GH_IMG_URL="https://github.com/${REPO}/releases/download/${GH_TAG}/${IMG}"
	GH_SHA_URL="https://github.com/${REPO}/releases/download/${GH_TAG}/sha256sums"
	GH_SIZE=$(remote_size "$GH_IMG_URL")
	case "$GH_SIZE" in ''|*[!0-9]*) GH_SIZE=0 ;; esac
	GH_PUB=""
	return 0
}

# Zed-Github：取发布列表中第一条【本产品前缀】且带 R 日期的 tag
# （CLI/调试路径：仅在未传 tag 时使用；浏览器流程不会走这里）
# （同仓库多产品共存：releases/latest 可能是另一产品的 tag，必须按前缀过滤）

# Zed-NAS：静态站（成功设置 ST_* 全局，返回 0）
static_probe() {
	local raw
	raw=$(curl_retry -fsSL --max-time 10 "$STATIC_VER_URL" 2>/dev/null | tr -d '\r\n' | cut -c1-40)
	ST_DATE=$(printf '%s' "$raw" | grep -o 'R\{0,1\}[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}' | head -n1)
	[ -n "$ST_DATE" ] || return 1
	ST_RDATE=$ST_DATE
	case "$ST_RDATE" in R*) ;; *) ST_RDATE="R$ST_RDATE" ;; esac
	ST_SIZE=$(remote_size "$STATIC_IMG_URL")
	case "$ST_SIZE" in ''|*[!0-9]*) ST_SIZE=0 ;; esac
	return 0
}

# ---------- 核心校验（download 后台流程与 install 前各调用一次） ----------
# 返回 0 = 匹配；1 = 不匹配/缺文件
verify_core() {
	local asset fw want got
	asset=$(asset_get)
	fw="$WORK/$asset"
	[ -f "$fw" ] && [ -f "$WORK/sha256sums" ] || return 1
	want=$(awk -v f="$asset" '
		{
			name = $2; sub(/^\*/, "", name);
			if (name == f) { print $1; exit }
		}' "$WORK/sha256sums")
	[ -n "$want" ] || return 1
	got=$(sha256sum "$fw" | awk '{print $1}')
	[ "$want" = "$got" ]
}

# ---------- 子命令 ----------
# do_check [source]：source=前台所选源（github=Zed-Github | static=Zed-NAS，默认 github），白名单
do_check() {
	local local_v sel gh_ok st_ok gh_checked st_checked selected_ok upd asset img_url sha_url size
	local fam src_in tag_in size_in
	# 首参可选家族（official|lede，与 github/static 不同词表）→ 无歧义；
	# 兼容旧位置参数（CLI：check [source] [tag] [size]）
	case "${1:-}" in
	official|lede) fam=$1; src_in=${2:-}; tag_in=${3:-}; size_in=${4:-} ;;
	*) fam=""; src_in=${1:-}; tag_in=${2:-}; size_in=${3:-} ;;
	esac
	[ -n "$fam" ] || fam=$FAMILY
	local_v=$(local_ver)
	[ -n "$local_v" ] || fail "无法读取本地固件版本"

	# 型号未开放 OTA：仅回显状态，不探测任何源
	if [ "$PROFILE" = "unsupported" ]; then
		log_line "检查更新：该型号暂未开放 OTA（本地 ${local_v}）"
		emit "{\"ok\":true,\"local\":\"$(jesc "$local_v")\",\"profile\":\"unsupported\"," \
			"\"supported\":false,\"model\":\"$(jesc "$(model_name)")\"}"
		exit 0
	fi

	# 108M 方案校验不过：明确拒绝并提示（不探测、不给 URL）
	if [ "$PROFILE" = "360t7-108m" ] && ! flash_108m_ok; then
		log_line "检查更新：拒绝（固件方案不匹配，非108M路由器，本地 ${local_v}）"
		emit "{\"ok\":true,\"local\":\"$(jesc "$local_v")\",\"profile\":\"${PROFILE}\"," \
			"\"supported\":true,\"flash_compatible\":false," \
			"\"error\":\"本固件源不兼容非108M版本路由器\"}"
		exit 0
	fi

	# LEDE 家族：尚未提供固件源（用户 2026-10-04：选中/识别到 LEDE 时提示期待）
	if [ "$fam" = "lede" ]; then
		log_line "检查更新：LEDE 固件源尚未提供（本地 ${local_v}）"
		emit "{\"ok\":true,\"local\":\"$(jesc "$local_v")\",\"profile\":\"${PROFILE}\"," \
			"\"supported\":true,\"flash_compatible\":true,\"family\":\"lede\"," \
			"\"fw_available\":false,\"active\":\"\",\"selected_ok\":false," \
			"\"has_update\":false,\"model\":\"$(jesc "$(model_name)")\"," \
			"\"sources\":{},\"img_url\":\"\",\"sha_url\":\"\",\"asset\":\"\",\"size\":0}"
		exit 0
	fi

	# source 缺省 → 型号默认源（全型号统一 GitHub）
	if [ -z "$src_in" ]; then
		sel=$DEFAULT_SRC
	else
		case "$src_in" in
		static) sel=static ;;
		*) sel=github ;;
		esac
	fi

	# 只探测所选源（点哪个查哪个），另一源标记为未检测
	gh_ok=false; st_ok=false
	gh_checked=false; st_checked=false
	if [ "$sel" = github ]; then
		gh_checked=true
		if [ -n "$tag_in" ]; then
			# 前端/CLI 传入的 tag → 零 API 构造
			if gh_from_tag "$tag_in"; then gh_ok=true; fi
		elif lb_probe; then
			# 后端直接读固定版本文件（零 api）
			gh_ok=true
		fi
		# 浏览器 API 顺带带回的体积优先（路由器侧 HEAD github 常超时/拿不到
		# content-length 导致 size=0，空间检查会显示"未获取到"）
		case "$size_in" in
		''|*[!0-9]*) ;;
		*) [ "${size_in:-0}" -gt 0 ] && GH_SIZE=$size_in ;;
		esac
	else
		st_checked=true
		if static_probe; then st_ok=true; fi
	fi

	# selected_ok=所选源是否可达；不可达则不给 URL、不动本地产物
	selected_ok=false
	asset=""; img_url=""; sha_url=""; size=0; upd=false
	if [ "$sel" = github ] && [ "$gh_ok" = true ]; then
		selected_ok=true
		size=$GH_SIZE
		img_url=$GH_IMG_URL
		sha_url=$GH_SHA_URL
		asset=$IMG
		[ "$GH_DATE" \> "$local_v" ] && upd=true
	elif [ "$sel" = static ] && [ "$st_ok" = true ]; then
		selected_ok=true
		size=$ST_SIZE
		img_url=$STATIC_IMG_URL
		sha_url=$STATIC_SHA_URL
		asset=$STATIC_ASSET
		[ "$ST_RDATE" \> "$local_v" ] && upd=true
	fi

	# 注意：固件不同于插件——版本一致/线上更旧也保留下载产物与刷写能力，
	# has_update 仅作提示字段交前端展示，由用户自行判断是否刷写。

	# 操作日志（≤100行；keep.d 声明 → 固件刷新后仍在）
	remote=""
	[ "$sel" = github ] && [ "$gh_ok" = true ] && remote=${GH_DATE:-}
	[ "$sel" = static ] && [ "$st_ok" = true ] && remote=${ST_RDATE:-}
	if [ "$selected_ok" = false ]; then
		log_line "检查更新[$sel]：所选源不可达（本地 $local_v）"
	elif [ "$upd" = true ]; then
		log_line "检查更新[$sel]：线上较新（$local_v → $remote）"
	elif [ "$remote" = "$local_v" ]; then
		log_line "检查更新[$sel]：与线上一致（$local_v，可重刷）"
	else
		log_line "检查更新[$sel]：本地高于线上（本地 $local_v > 线上 $remote，可刷写）"
	fi

	emit "{\"ok\":true,\"local\":\"${local_v}\",\"profile\":\"${PROFILE}\",\"supported\":true," \
		"\"family\":\"${fam}\",\"fw_available\":true," \
		"\"model\":\"$(jesc "$(model_name)")\"," \
		"\"active\":\"${sel}\"," \
		"\"selected_ok\":${selected_ok},\"has_update\":${upd}," \
		"\"sources\":{" \
		"\"github\":{\"ok\":${gh_ok},\"checked\":${gh_checked},\"version\":\"$(jesc "${GH_DATE:-}")\"," \
		"\"tag\":\"$(jesc "${GH_TAG:-}")\",\"size\":${GH_SIZE:-0}," \
		"\"published\":\"$(jesc "${GH_PUB:-}")\"}," \
		"\"static\":{\"ok\":${st_ok},\"checked\":${st_checked},\"version\":\"$(jesc "${ST_DATE:-}")\"," \
		"\"size\":${ST_SIZE:-0}}}," \
		"\"img_url\":\"$(jesc "$img_url")\",\"sha_url\":\"$(jesc "$sha_url")\"," \
		"\"asset\":\"$(jesc "$asset")\",\"size\":${size}}"
}

do_space() {
	local fw cfg need free total enough cached cbytes
	fw=${1:-0}
	case "$fw" in ''|*[!0-9]*) fail "参数错误" ;; esac

	cfg=$(cfg_size)
	cbytes=$(cached_bytes)
	# 本地已缓存部分 = 原地替换，不重复计入需求
	cached=0
	if [ "$cbytes" -gt 0 ] && [ "$fw" -gt 0 ]; then
		cached=$cbytes
		[ "$cached" -gt "$fw" ] && cached=$fw
	fi
	free=$(tmp_free)
	total=$(tmp_total)
	need=$((fw - cached + cfg + MARGIN))
	enough=false
	[ "$free" -ge "$need" ] && enough=true

	log_line "空间检查：固件 $fw（本地已缓存 $cbytes，计减 $cached）+ 配置 $cfg + 余量 $MARGIN = 需 $need / 可用 $free（够=$enough）"

	emit "{\"ok\":true,\"fw\":${fw},\"cached\":${cbytes},\"cfg\":${cfg},\"margin\":${MARGIN}," \
		"\"need\":${need},\"free\":${free},\"total\":${total},\"enough\":${enough}}"
}

# do_download <bytes> [source]：source=前台所选源（默认 github），白名单，不自动切换
do_download() {
	local fw cfg free total need size stage sel asset img_url sha_url
	local fam="${1:-}"

	# 家族可选首位（official|lede，与数字 size 词表不相交）
	case "$fam" in
	official|lede) shift ;;
	*) fam=$FAMILY ;;
	esac
	[ "$fam" != "lede" ] || fail "LEDE 固件源尚未提供，敬请期待"

	fw=${1:-0}
	case "$fw" in ''|*[!0-9]*) fail "参数错误" ;; esac
	[ "$PROFILE" != "unsupported" ] || fail "该型号暂未开放在线升级"
	if [ "$PROFILE" = "360t7-108m" ] && ! flash_108m_ok; then
		log_line "下载中止：固件方案不匹配（非108M路由器）"
		fail "本固件源不兼容非108M版本路由器"
	fi
	case "${2:-$DEFAULT_SRC}" in
	static) sel=static ;;
	*) sel=github ;;
	esac

	stage=$(stage_get)
	[ "$stage" = "downloading" ] && fail "固件正在下载中"

	# 按用户所选源取地址（不可达即报错，不偷偷换源）
	if [ "$sel" = github ]; then
		# 显式 tag（CLI）→ 直接构造；否则后端直读固定版本文件（零 api）
		if [ -n "${3:-}" ]; then
			gh_from_tag "$3" || fail "非法的固件版本标识"
		elif ! lb_probe; then
			fail "Zed-Github 版本文件不可达（last_build.txt 读取失败），可切换 Zed-NAS"
		fi
		asset=$IMG
		img_url=$GH_IMG_URL
		sha_url=$GH_SHA_URL
		size=$GH_SIZE
	else
		if static_probe; then
			asset=$STATIC_ASSET
			img_url=$STATIC_IMG_URL
			sha_url=$STATIC_SHA_URL
			size=$ST_SIZE
		else
			fail "所选固件源（Zed-NAS）不可达，请切换固件源后重试"
		fi
	fi

	# 下载前强制空间检查（需求 2.3）：优先用前端传来的 check 体积
	[ "$fw" -gt 0 ] && size=$fw
	[ "$size" -gt 0 ] || fail "无法获取固件体积，无法执行空间检查"
	cfg=$(cfg_size)
	cbytes=$(cached_bytes)
	cached=0
	if [ "$cbytes" -gt 0 ] && [ "$size" -gt 0 ]; then
		cached=$cbytes
		[ "$cached" -gt "$size" ] && cached=$size
	fi
	free=$(tmp_free)
	total=$(tmp_total)
	need=$((size - cached + cfg + MARGIN))
	if [ "$free" -lt "$need" ]; then
		log_line "下载中止[$sel]：tmpfs 空间不足（需 $need / 可用 $free）"
		emit "{\"ok\":false,\"error\":\"tmpfs 空间不足，无法下载固件\"," \
			"\"code\":\"space\",\"fw\":${size},\"cached\":${cbytes},\"cfg\":${cfg},\"margin\":${MARGIN}," \
			"\"need\":${need},\"free\":${free},\"total\":${total}}"
		exit 0
	fi

	# 重置工作区（busy 检查已在前面通过）
	rm -rf "$WORK"
	mkdir -p "$WORK"
	printf '%s' "$asset" > "$WORK/asset"
	printf '%s' "$sel" > "$WORK/source"
	printf '%s' "$size" > "$WORK/expected"
	echo downloading > "$WORK/stage"
	log_line "开始下载[$sel] $asset（$size 字节）"

	# 后台下载 + 自动校验（liquid/pushbot 同款"子 shell &"模式，不阻塞 rpcd）
	(
		# 先取 sha256sums：拿不到就中止，绝不落无校验的固件（需求 2.2）
		if ! curl -fsSL --retry 3 --max-time 600 -o "$WORK/sha256sums" "$sha_url"; then
			if [ "$sel" = static ]; then
				echo "Zed-NAS 未提供 sha256sums，无法校验，已中止下载" > "$WORK/err"
				log_line "下载失败[$sel]：Zed-NAS 无 sha256sums，已中止"
			else
				echo "sha256sums 下载失败" > "$WORK/err"
				log_line "下载失败[$sel]：sha256sums 获取失败"
			fi
			echo failed > "$WORK/stage"
			exit 1
		fi
		if ! curl -fL --retry 3 --max-time 1800 -o "$WORK/$asset.part" "$img_url"; then
			echo "固件下载失败" > "$WORK/err"
			log_line "下载失败[$sel]：固件传输失败"
			echo failed > "$WORK/stage"
			exit 1
		fi
		mv "$WORK/$asset.part" "$WORK/$asset"
		echo verifying > "$WORK/stage"
		if verify_core; then
			log_line "下载完成并 sha256 校验通过[$sel] $asset"
			echo ready > "$WORK/stage"
		else
			echo "下载成功但固件校验失败" > "$WORK/err"
			log_line "校验失败[$sel]：已删除产物 $asset"
			rm -f "$WORK/$asset" "$WORK/sha256sums"
			echo failed > "$WORK/stage"
		fi
	) >> "$WORK/dl.log" 2>&1 &

	emit "{\"ok\":true,\"stage\":\"downloading\",\"source\":\"${sel}\",\"asset\":\"$(jesc "$asset")\"}"
}

do_progress() {
	local stage got total percent asset fc
	stage=$(stage_get)
	asset=$(asset_get)
	got=0
	[ -f "$WORK/$asset.part" ] && got=$(wc -c < "$WORK/$asset.part" | tr -dc '0-9')
	if [ "$got" -eq 0 ] && [ -f "$WORK/$asset" ]; then
		got=$(wc -c < "$WORK/$asset" | tr -dc '0-9')
	fi
	total=$(cat "$WORK/expected" 2>/dev/null | tr -dc '0-9')
	total=${total:-0}
	percent=0
	if [ "$total" -gt 0 ] && [ "$got" -gt 0 ]; then
		percent=$((got * 100 / total))
		[ "$percent" -gt 100 ] && percent=100
	fi
	[ "$stage" = "ready" ] && percent=100

	# 108M 方案校验随加载路径一并返回（前端在型号显示处直接拒绝，不等检查更新）
	fc=true
	[ "$PROFILE" = "360t7-108m" ] && ! flash_108m_ok && fc=false
	emit "{\"ok\":true,\"stage\":\"${stage}\",\"got\":${got},\"total\":${total}," \
		"\"percent\":${percent},\"source\":\"$(cat "$WORK/source" 2>/dev/null)\"," \
		"\"error\":\"$(jesc "$(err_get)")\"," \
		"\"model\":\"$(jesc "$(model_name)")\",\"local\":\"$(jesc "$(local_ver)")\"," \
		"\"profile\":\"${PROFILE}\",\"flash_compatible\":${fc},\"family\":\"${FAMILY}\"}"
}

do_install() {
	local asset fw test_out
	asset=$(asset_get)
	fw="$WORK/$asset"
	[ -f "$fw" ] || { log_line "刷机中止：没有已下载的固件"; fail "没有已下载的固件"; }

	# 需求 2.2：执行更新前再次校验，不匹配则删除产物并明确提示
	if ! verify_core; then
		rm -f "$fw" "$WORK/sha256sums"
		echo "下载成功但固件校验失败" > "$WORK/err"
		echo failed > "$WORK/stage"
		log_line "刷机中止：刷前二次校验失败，已删除产物 $asset"
		fail "下载成功但固件校验失败，已删除固件产物"
	fi

	# 与官方 flash 页一致：先 --test 平台校验
	if ! test_out=$(sysupgrade --test "$fw" 2>&1); then
		printf '%s\n' "$test_out" > "$WORK/install.log"
		log_line "刷机中止：sysupgrade --test 未通过（$asset）"
		fail "sysupgrade 镜像校验未通过，未执行刷机"
	fi

	echo installing > "$WORK/stage"
	log_line "开始刷机 $asset（校验与平台测试通过，保留配置，设备即将重启）"
	(
		sysupgrade -v "$fw" > "$WORK/install.log" 2>&1
	) &
	emit "{\"ok\":true,\"stage\":\"installing\"}"
}

do_clean() {
	local f name sz
	case "${1:-}" in
	fw)
		# 清除固件缓存：整个下载工作区（进度/校验文件一并复位）
		sz=$(cached_bytes)
		rm -rf "$WORK"
		mkdir -p "$WORK"
		log_line "清理 固件缓存：已清除，释放 $sz 字节"
		emit "{\"ok\":true,\"freed\":${sz},\"target\":\"fw\"," \
			"\"msg\":\"固件缓存已清除（释放 ${sz} 字节），可重新下载\"}"
		exit 0
		;;
	smart)
		f=$SMART_FILE
		name="OpenClash Smart 缓存"
		;;
	udpxy)
		f=$UDPXY_FILE
		name="udpxy 缓存"
		;;
	*)
		fail "未知清理目标"
		;;
	esac

	if [ ! -e "$f" ]; then
		log_line "清理 $name：目标不存在"
		emit "{\"ok\":true,\"freed\":0,\"target\":\"$(jesc "$1")\"," \
			"\"msg\":\"${name} 不存在，已干净\"}"
		exit 0
	fi

	sz=$(wc -c < "$f" | tr -dc '0-9')
	sz=${sz:-0}

	# 关键：进程（clash / udpxy）持有句柄，rm 不释放空间 —— 原地清零截断
	if : > "$f" 2>/dev/null; then
		log_line "清理 $name：已清空，释放 $sz 字节"
		emit "{\"ok\":true,\"freed\":${sz},\"target\":\"$(jesc "$1")\"," \
			"\"msg\":\"${name} 已清空（原 ${sz} 字节），无需重启进程\"}"
	else
		log_line "清理 $name：清空失败（权限或只读）"
		fail "${name} 清空失败（权限不足或文件系统只读）"
	fi
}

# 输出操作日志（JSON 行数组；文件写入时已限100行）
do_log() {
	local out="" line
	if [ ! -f "$LOG_FILE" ]; then
		emit '{"ok":true,"lines":[],"msg":"暂无日志"}'
		return 0
	fi
	while IFS= read -r line || [ -n "$line" ]; do
		out="${out}\"$(jesc "$line")\","
	done < "$LOG_FILE"
	out="${out%,}"
	emit "{\"ok\":true,\"lines\":[${out}]}"
}

# 来源可达性诊断（2026-10-04 双侧检测：浏览器侧由前端自测，路由器侧走这里）。
# 只做 HEAD 连通性：github.com 主站（不耗 API 配额）+ 静态站固件头
do_diag() {
	local gh=false st=false
	# github 侧 = 真实"可下载"判定：读版本文件(带重试) + 资产直链 HEAD(带重试，
	# 会跟随跳转到 CDN —— CDN DNS 不通时这里就会判✗，与实际能否拉取一致)
	if lb_probe && curl_retry -sIL --max-time 10 -o /dev/null "$GH_IMG_URL" 2>/dev/null; then
		gh=true
	fi
	# 静态站侧同样带重试（与检查路径同标准，消灭单次 HEAD 的假阴性）
	if [ -n "$STATIC_IMG_URL" ] && curl_retry -sI --max-time 5 -o /dev/null "$STATIC_IMG_URL" 2>/dev/null; then
		st=true
	fi
	emit "{\"ok\":true,\"github\":${gh},\"static\":${st}}"
}

# ---------- 入口 ----------
cmd=${1:-}
[ $# -gt 0 ] && shift

case "$cmd" in
check)		do_check "${1:-}" "${2:-}" "${3:-}" "${4:-}" ;;
diag)		do_diag ;;
space)		do_space "${1:-0}" ;;
download)	do_download "${1:-}" "${2:-}" "${3:-}" "${4:-}" ;;
progress)	do_progress ;;
install)	do_install ;;
clean)		do_clean "${1:-}" ;;
log)		do_log ;;
*)
	emit '{"ok":false,"error":"用法: zed-opota check|space|download|progress|install|clean|log"}'
	;;
esac
