#!/bin/sh
expr=""
while [ $# -gt 0 ]; do case "$1" in -e) expr=$2; shift;; esac; shift; done
input=$(cat)
python3 -c '
import json,sys
try: d=json.loads(sys.argv[1])
except Exception: sys.exit(0)
e=sys.argv[2].lstrip("@")

def walk(cur, e):
    if not e: return cur
    if isinstance(cur, list) and e.startswith("["):
        return None
    for part in e.split("."):
        if part=="": continue
        if isinstance(cur, dict) and part in cur: cur=cur[part]
        else: return None
    return cur
v = walk(d, e)
if v is None or isinstance(v,(dict,list)): sys.exit(0)
print(v)
' "$input" "$expr"
