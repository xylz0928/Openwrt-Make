#!/bin/sh
expr=""
while [ $# -gt 0 ]; do case "$1" in -e) expr=$2; shift;; esac; shift; done
input=$(cat)
python3 -c '
import json,sys
try: d=json.loads(sys.argv[1])
except Exception: sys.exit(0)
e=sys.argv[2].lstrip("@")
cur=d
if e:
    for part in e.split("."):
        if part=="" : continue
        if isinstance(cur,list):
            idx=part.strip("[]*")
            if idx=="" :
                continue
            try: cur=cur[int(idx)]
            except Exception: sys.exit(0)
        elif isinstance(cur,dict) and part in cur:
            cur=cur[part]
        else:
            sys.exit(0)
if isinstance(cur,(dict,list)):
    sys.exit(0)
print(cur)
' "$input" "$expr"
